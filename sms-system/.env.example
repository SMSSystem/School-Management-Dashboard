VITE_FIREBASE_API_KEY="string-of-characters"
VITE_FIREBASE_AUTH_DOMAIN="string-of-characters"
VITE_FIREBASE_PROJECT_ID="string-of-characters"
VITE_FIREBASE_STORAGE_BUCKET="string-of-characters"
VITE_FIREBASE_MESSAGING_SENDER_ID="string-of-numbers"
VITE_FIREBASE_APP_ID="string-of-characters"
VITE_FIREBASE_MEASUREMENT_ID="string-of-characters"
VITE_FIREBASE_APPCHECK_SITE_KEY="string-of-characters"
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN="string-of-characters, dev/CI only"
# Realtime Database. VITE_FIREBASE_DATABASE_URL is REQUIRED in every environment (dev, e2e,
# production): large (>500 KiB) teacher/admin attachments are stored there
# (docs/miscellaneous-specs/LARGE_ATTACHMENTS_RTDB_SPEC.md, D11). It also backs the optional
# one-active-session-per-account lock (src/lib/sessionLock.ts), which is switched on separately
# by VITE_SINGLE_SESSION_ENABLED (production only; leave that one unset in dev/CI).
# Copy the exact URL from the Realtime Database page in the console, without a trailing slash.
# us-central1: https://<project-id>-default-rtdb.firebaseio.com
# other regions: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL="https://<project-id>-default-rtdb.firebaseio.com"
VITE_SINGLE_SESSION_ENABLED="true, production only"
